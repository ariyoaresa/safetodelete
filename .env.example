# ==============================================================================
# SafeToDelete Environment Configuration
# ==============================================================================

# Google AI Studio / Gemini API Key
# Used for live AI risk explanations, failure investigations, and cleanup advice.
# Get a key at: https://aistudio.google.com/
# If omitted, SafeToDelete operates in fully offline mode with deterministic synthesis.
GEMINI_API_KEY=

# Alternative key name (interchangeable with GEMINI_API_KEY)
GEMMA_API_KEY=

# Model selection for Google AI Studio API (Default: gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# (Optional) Custom or local inference server endpoint (e.g., Ollama, vLLM, LM Studio)
# Example for local Ollama: http://localhost:11434/api/generate
GEMMA_ENDPOINT=

# (Optional) Model identifier when querying a custom inference endpoint
GEMMA_MODEL=gemma4:latest

